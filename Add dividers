Piece 3A — jumpToDivider (Scrolls cleanly to any line)

        function jumpToDivider(idx, hr) {
            const ed = editors[idx];
            if (!ed) return;
            setActiveBoxIndex(idx);
            ed.focus();

            if (!hr) {
                const range = document.createRange();
                if (ed.firstChild) {
                    if (ed.firstChild.nodeType === 3) range.setStart(ed.firstChild, 0);
                    else range.selectNodeContents(ed.firstChild);
                } else {
                    range.setStart(ed, 0);
                }
                range.collapse(true);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
                ed.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            const range = document.createRange();
            if (hr.nextSibling) {
                if (hr.nextSibling.nodeType === 3) range.setStart(hr.nextSibling, 0);
                else range.selectNodeContents(hr.nextSibling);
                range.collapse(true);
            } else {
                range.setStartAfter(hr);
                range.collapse(true);
            }
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            hr.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

  - What this does: Moves your blinking typing cursor right below the divider
    line you picked, and scrolls that divider straight to the top of the box
    (block: 'start'). If hr is empty (null), it scrolls you back to the very top
    of the box.

