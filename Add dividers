Piece 3E — renderOutlineItems (Builds the clickable list)

        function renderOutlineItems() {
            const listEl = document.getElementById('outlineList');
            const query = (document.getElementById('outlineFilterInput').value || '').trim().toLowerCase();
            const ed = editors[outlineTargetBox];
            listEl.innerHTML = '';
            outlineVisibleEntries = [];

            const allDivs = [...ed.querySelectorAll('hr.section-divider')];
            const bigDivs = allDivs.filter(hr => hr.classList.contains('div-h1') || hr.classList.contains('div-h2'));
            const dividers = bigDivs.length ? bigDivs : allDivs;

            const entries = [{ level: 0, label: 'Top of Box', hr: null }];
            dividers.forEach(hr => {
                const level = hr.classList.contains('div-h1') ? 1 : (hr.classList.contains('div-h2') ? 2 : 3);
                entries.push({ level, label: getDividerLabel(hr), hr });
            });

            outlineVisibleEntries = query
                ? entries.filter(item => item.label.toLowerCase().includes(query))
                : entries;

            if (!dividers.length && !query) {
                listEl.innerHTML = '<div class="outline-empty">No dividers in this box yet.<br>Press <b>Alt+Shift+1 / 2 / 3</b> to add one.</div>';
                return;
            }

            if (!outlineVisibleEntries.length) {
                listEl.innerHTML = '<div class="outline-empty">No matching sections found.</div>';
                return;
            }

            if (outlineSelectedIdx >= outlineVisibleEntries.length) outlineSelectedIdx = 0;

            outlineVisibleEntries.forEach((entry, i) => {
                const btn = document.createElement('button');
                const lvlClass = entry.level === 1 ? 'is-h1' : (entry.level === 2 ? 'is-h2' : (entry.level === 3 ? 'is-note' : ''));
                btn.className = `outline-item ${lvlClass} ${i === outlineSelectedIdx ? 'selected' : ''}`;
                const badge = entry.level === 1
                    ? '<span class="outline-badge h1">1</span>'
                    : (entry.level === 2 ? '<span class="outline-badge h2">2</span>'
                    : (entry.level === 3 ? '<span class="outline-badge note">—</span>' : '<span class="outline-badge h1">TOP</span>'));
                btn.innerHTML = `${badge}<span class="outline-text"></span>`;
                btn.querySelector('.outline-text').textContent = entry.label;
                btn.onclick = () => {
                    jumpToDivider(outlineTargetBox, entry.hr);
                    closeOutlineMenu();
                };
                listEl.appendChild(btn);
            });
        }

  - What this does:
    1.  Checks if the box has Green (1) or Blue (2) dividers. If yes, it shows
        those cleanly; if not, it automatically shows your Dashed (—) dividers
        instead.
    2.  Filters the list as you type.
    3.  Turns each one into a button that jumps straight to that line when
        clicked.

Piece 3F — handleOutlineKeydown (Keyboard controls inside the popup)

        function handleOutlineKeydown(e) {
            if (e.key === 'Escape') {
                e.preventDefault();
                closeOutlineMenu();
                editors[outlineTargetBox]?.focus();
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (outlineVisibleEntries.length) {
                    outlineSelectedIdx = (outlineSelectedIdx + 1) % outlineVisibleEntries.length;
                    renderOutlineItems();
                    document.querySelector('#outlineList .outline-item.selected')?.scrollIntoView({ block: 'nearest' });
                }
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (outlineVisibleEntries.length) {
                    outlineSelectedIdx = (outlineSelectedIdx - 1 + outlineVisibleEntries.length) % outlineVisibleEntries.length;
                    renderOutlineItems();
                    document.querySelector('#outlineList .outline-item.selected')?.scrollIntoView({ block: 'nearest' });
                }
            } else if (e.key === 'Enter') {
                e.preventDefault();
                const picked = outlineVisibleEntries[outlineSelectedIdx];
                if (picked) {
                    jumpToDivider(outlineTargetBox, picked.hr);
                    closeOutlineMenu();
                }
            }
        }

  - What this does: Lets you press ↑ / ↓ to move through the list, Enter to
    jump, and Esc to close it without using your mouse.

