        function jumpSection(idx, direction, bigLinesOnly = false) {
            const ed = editors[idx];
            if (!ed) return;
            setActiveBoxIndex(idx);
            ed.focus();

            const selector = bigLinesOnly ? 'hr.div-h1, hr.div-h2' : 'hr.section-divider';
            const dividers = [...ed.querySelectorAll(selector)];
            if (!dividers.length) {
                toast(bigLinesOnly ? 'No Green or Blue dividers in this box' : 'No dividers in this box');
                return;
            }

            const sel = window.getSelection();
            let currentFocusNode = sel.focusNode || ed;
            let currentSectionIndex = 0;

            for (let i = 0; i < dividers.length; i++) {
                const div = dividers[i];
                if (div.compareDocumentPosition(currentFocusNode) & Node.DOCUMENT_POSITION_FOLLOWING) {
                    currentSectionIndex = i + 1;
                }
            }

            let target = currentSectionIndex + direction;
            if (target < 0) target = 0;
            if (target > dividers.length) target = dividers.length;

            jumpToDivider(idx, target === 0 ? null : dividers[target - 1]);
        }

  - What this does: When bigLinesOnly is false (Alt + ↑/↓), it steps through
    all 3 divider lines. When bigLinesOnly is true (Alt + Shift + ↑/↓), it
    ignores the small dashed lines and only hops between Green and Blue lines.

Piece 3C — getDividerLabel (Reads your plain text below the line)

        let outlineTargetBox = 0;
        let outlineSelectedIdx = 0;
        let outlineVisibleEntries = [];

        function getDividerLabel(hr) {
            let node = hr.nextSibling;
            while (node) {
                if (node.nodeType === 1 && node.matches('hr.section-divider')) break;
                const raw = node.nodeType === 3 ? node.nodeValue : (node.innerText || node.textContent || '');
                const firstLine = raw.split(/\r?\n/).map(s => s.trim()).find(Boolean);
                if (firstLine) return firstLine.length > 55 ? firstLine.slice(0, 52) + '...' : firstLine;
                node = node.nextSibling;
            }
            if (hr.classList.contains('div-h1')) return 'Untitled Section 1';
            if (hr.classList.contains('div-h2')) return 'Untitled Section 2';
            return 'Untitled Note';
        }

  - What this does: Looks at whatever normal plain text is written right below a
    divider line and grabs the first line as its label in the menu (cuts it off
    at 55 characters so the menu stays neat).

